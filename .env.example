# ===== GramBiz AI environment =====
# Copy to .env and fill in real values. NEVER commit this file or real keys.

# --- Database ---
# production (PostGIS + pgvector via docker-compose):
DATABASE_URL=postgresql+psycopg://grambiz:grambiz@localhost:5432/grambiz
# sandbox fallback uses a writable local cluster (see docs/assumptions.md)

# --- LLM ---
LLM_PROVIDER=nvidia            # mock | openai | anthropic | nvidia
LLM_API_KEY=                   # set via gitignored .env, never in this template
LLM_MODEL=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Map tiles (MapCN/MapLibre style URL) ---
# e.g. a MapLibre demo style or self-hosted style; keep keys env-based
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Providers ---
WEATHER_API_KEY=
MARKET_PRICE_API_KEY=
DATA_PROVIDER_KEYS=          # comma-separated provider key=value pairs

# --- data.gov.in official runners (Phase 4/6) ---
# Free API key: https://data.gov.in/help/how-use-data-govin-apis
# Scripts fail fast (exit 2) rather than fabricate data when these are empty.
DATA_GOV_API_KEY=
DATA_GOV_MARKET_RESOURCE=    # confirmed data.gov.in resource id for market prices
IMD_RAINFALL_RESOURCE=       # confirmed data.gov.in resource id for IMD rainfall
SOIL_HEALTH_RESOURCE=        # confirmed data.gov.in resource id for Soil Health Card nutrient analysis
UDYAM_RESOURCE=              # confirmed data.gov.in resource id for the UDYAM MSME unit list (P0)
UDYAM_STATE=Tamil Nadu       # default state filter for UDYAM ingest
UDYAM_PINCODE_DIRECTORY=     # optional CSV path: pincode,latitude,longitude (pincode->centroid)

# --- OSM Overpass ---
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_RPM=60
